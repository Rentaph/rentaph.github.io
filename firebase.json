{
  "hosting": {
    "target": "main",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      ".gitignore",
      ".nojekyll",
      "android/**",
      "README.md",
      "firestore.rules",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "max-age=300" }] },
      { "source": "/brgy/**", "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }] }
    ]
  }
}
